{
  "name": "hostiggo-mail",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "build": "npm --prefix web run build && npm run build:api",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen:key": "node -e \"console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))\"",
    "dev:web": "npm --prefix web run dev",
    "build:api": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "postinstall": "npm --prefix web install"
  },
  "description": "Hostiggo Mail: email automation platform API + worker",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
