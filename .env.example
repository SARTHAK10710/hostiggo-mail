# ── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000      # public URL of this API (OAuth redirect + unsubscribe links)
APP_BASE_URL=http://localhost:4000      # dashboard URL (OAuth returns here). Use http://localhost:5173 with `npm run dev:web`
CORS_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────
# Local dev: embedded Postgres, worker runs inside the API process.
DATABASE_URL=pglite:./.data/pglite
# Real Postgres / Supabase (run `npm run start:worker` separately):
# DATABASE_URL=postgres://user:pass@host:5432/hostiggo_mail

# ── Secrets (required in production; dev uses built-in insecure defaults) ──
# APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Generate with `npm run gen:key`. Comma-separate to rotate: first key encrypts, all keys decrypt.
# TOKEN_ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES

# ── Email delivery ───────────────────────────────────────
# fake  = no Google needed; a local consent screen + in-memory outbox (for frontend work)
# gmail = real Google OAuth + Gmail API
EMAIL_PROVIDER_MODE=fake
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_DEFAULT_DAILY_LIMIT=400
GMAIL_MAX_CAMPAIGN_RECIPIENTS=300

# ── Reply tracking (Phase 5) ─────────────────────────────
# Adds the gmail.metadata scope (restricted: needs Google verification for public apps).
GMAIL_REPLY_TRACKING=false
GMAIL_PUBSUB_TOPIC=                      # projects/<project>/topics/<topic>; empty = periodic sync only
PUBSUB_AUDIENCE=                         # audience configured on the push subscription
PUBSUB_SERVICE_ACCOUNT_EMAIL=            # service account the push subscription signs as
PUBSUB_VERIFICATION_TOKEN=               # dev-only fallback: ?token= on the push URL
REPLY_ATTRIBUTION_DAYS=7

# ── ESP webhooks (later) ─────────────────────────────────
PROVIDER_WEBHOOK_SECRETS=                # name:secret,name2:secret2

# Visible "unsubscribe" line in marketing emails (the hidden List-Unsubscribe header is always sent)
UNSUBSCRIBE_FOOTER=true

# -- Launch readiness (phase 6) ---------------------------------
ALLOW_SIGNUPS=true                       # false = invite-only (first account is always allowed)
RATE_LIMIT=true                          # per-IP limits; sign-in is limited to 10/min
LOG_REQUESTS=false                       # true logs every HTTP request (noisy)
COMPANY_NAME=Hostiggo                    # shown on /privacy, /terms, /support
SUPPORT_EMAIL=                           # e.g. support@hostiggo.com (needed for Google verification)
OPERATOR_EMAILS=                         # who sees server-wide queue/backups; default: first account
BACKUP_EVERY_HOURS=24                    # embedded database only; 0 disables
BACKUP_KEEP=7
BACKUP_DIR=./backups
